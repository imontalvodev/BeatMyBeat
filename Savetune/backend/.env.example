# Puerto del backend (opcional)
# PORT=4000

# Provider de letras:
# - hybrid: intenta lyrics.ovh y, si falla, cae a letras.com (recomendado)
# - ovh: solo lyrics.ovh
# - legacy: solo letras.com
LYRICS_PROVIDER=hybrid

# Base URL del proveedor tipo lyrics.ovh (API pública o instancia autoalojada).
LYRICS_OVH_BASE_URL=https://api.lyrics.ovh

# Timeout (segundos) para requests al proveedor primario de letras.
LYRICS_OVH_TIMEOUT_SECONDS=8

# YouTube Data API v3 — necesaria para búsquedas desde IPs de datacenter (Hetzner, etc.)
# Obtén tu clave en: https://console.cloud.google.com/ → APIs & Services → Credenciales
YOUTUBE_API_KEY=

# Anti-bot YouTube: cookies exportadas desde el navegador (Netscape format)
# Ruta dentro del contenedor (montada como volumen en docker-compose.prod.yml)
YOUTUBE_COOKIES_FILE=/app/cookies.txt
