# Spotify Web API (opcional). Si están definidas, se usa la API en lugar del scraper.
# Obtén las credenciales en: https://developer.spotify.com/dashboard
# Nota: Get Playlist Items solo permite playlists del usuario actual; con Client Credentials
# puede dar 403 en playlists que no sean del usuario asociado. Para playlists propias
# puede ser necesario usar OAuth con tu cuenta.
SPOTIFY_CLIENT_ID=tu_client_id
SPOTIFY_CLIENT_SECRET=tu_client_secret

# Puerto del backend (opcional)
# PORT=4000

# Provider de letras:
# - hybrid: intenta lyrics.ovh y, si falla, cae a letras.com (recomendado)
# - ovh: solo lyrics.ovh
# - legacy: solo letras.com
LYRICS_PROVIDER=hybrid

# Base URL del proveedor tipo lyrics.ovh (API pública o instancia autoalojada).
LYRICS_OVH_BASE_URL=https://api.lyrics.ovh

# Timeout (segundos) para requests al proveedor primario de letras.
LYRICS_OVH_TIMEOUT_SECONDS=8
